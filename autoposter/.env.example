# Ключ Claude API (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Токен бота из @BotFather. Бот должен быть АДМИНОМ канала с правом "Публикация сообщений".
BOT_TOKEN=123456:ABC-DEF...

# Канал: @username (если публичный) или числовой id вида -1001234567890 (если приватный)
CHANNEL_ID=@your_channel

# Твой chat_id — кому слать темы в 11:00 и кто может публиковать.
# Узнать: запусти бота, напиши ему /start — он покажет твой chat_id.
EDITOR_CHAT_ID=

# --- Зеркало в MAX ---

# Токен ВТОРОГО Telegram-бота (@BotFather) — только для чтения канала.
# Добавь его админом в тот же канал (права можно все выключить).
MIRROR_BOT_TOKEN=

# Числовой id канала MAX.
# Узнать: python tg_to_max_user.py --max-chats  (или tg_to_max.py --max-chats)
MAX_CHAT_ID=

# Вариант А (tg_to_max_user.py, без ИП): личный аккаунт MAX.
# Номер телефона аккаунта, при первом запуске спросит SMS-код.
MAX_PHONE=

# Вариант Б (tg_to_max.py): официальный бот MAX (нужна верификация
# ИП/самозанятого). Токен создаётся у @masterbot в приложении MAX,
# бот — админ канала с правом публикации.
MAX_BOT_TOKEN=

# Необязательно
# MODEL=claude-opus-4-8
# POST_HOUR=11
# TZ=Europe/Moscow
# MAX_API_BASE=https://platform-api2.max.ru
